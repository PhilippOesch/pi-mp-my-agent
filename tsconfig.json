{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["vitest.config.ts", "tests/**/*.ts", "extensions/**/*.ts"],
    "exclude": ["extensions/subagents/**", "extensions/memory/**"]
}
