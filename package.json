{
    "name": "pi-mp-my-agent",
    "version": "0.1.0",
    "description": "Personal Pi coding agent package with extensions, skills, themes, and agents.",
    "type": "module",
    "keywords": [
        "pi-package"
    ],
    "private": true,
    "workspaces": [
        "extensions/subagents",
        "extensions/memory"
    ],
    "scripts": {
        "check:agents": "node scripts/check-agents.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p extensions/subagents/tsconfig.json && tsc --noEmit -p extensions/memory/tsconfig.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "circular": "npx madge --circular --extensions ts .",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run circular && npm run check:agents"
    },
    "files": [
        "extensions",
        "skills",
        "themes",
        "agents",
        "LICENSE",
        "README.md"
    ],
    "pi": {
        "extensions": [
            "./extensions/block-command.ts",
            "./extensions/btw.ts",
            "./extensions/exit-command.ts",
            "./extensions/favorite-models/index.ts",
            "./extensions/herdr-agent-state.ts",
            "./extensions/hidden-thinking-label.ts",
            "./extensions/instructions.ts",
            "./extensions/markdown-preview/index.ts",
            "./extensions/mcp-approval.ts",
            "./extensions/memory/src/index.ts",
            "./extensions/path-blacklist/index.ts",
            "./extensions/read-mode-toggle/index.ts",
            "./extensions/subagents/src/index.ts",
            "./extensions/todo/index.ts",
            "./extensions/working-indicator.ts"
        ],
        "skills": [
            "./skills/*"
        ],
        "themes": [
            "./themes/*.json"
        ]
    },
    "dependencies": {
        "marked": "^18.1.0"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "1.4.0",
        "@earendil-works/pi-tui": "1.4.0",
        "@types/node": "*",
        "typebox": "*",
        "typescript": "^5.9.3",
        "vitest": "^5.0.3"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-agent-core": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    }
}
