{
    "name": "pi-mp-my-agent",
    "version": "0.1.0",
    "description": "Personal Pi coding agent package with extensions, prompts, themes, and agents.",
    "type": "module",
    "keywords": [
        "pi-package"
    ],
    "private": true,
    "workspaces": [
        "extensions/subagents",
        "extensions/memory"
    ],
    "scripts": {
        "check:agents": "node scripts/check-agents.mjs",
        "typecheck": "npm run typecheck:subagents && npm run typecheck:memory",
        "typecheck:subagents": "cd extensions/subagents && npm run typecheck",
        "typecheck:memory": "cd extensions/memory && npm run typecheck",
        "lint": "npm run lint:subagents && npm run lint:memory",
        "lint:subagents": "cd extensions/subagents && npm run lint",
        "lint:memory": "cd extensions/memory && npm run lint",
        "format:check": "npx prettier --check extensions/subagents extensions/memory extensions/shared",
        "format": "npx prettier --write extensions/subagents extensions/memory extensions/shared",
        "test": "cd extensions/subagents && npm test",
        "circular": "npm run circular:subagents && npm run circular:memory",
        "circular:subagents": "cd extensions/subagents && npm run circular",
        "circular:memory": "cd extensions/memory && npm run circular",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run circular"
    },
    "files": [
        "extensions",
        "prompts",
        "themes",
        "agents",
        "LICENSE",
        "README.md"
    ],
    "pi": {
        "extensions": [
            "./extensions/block-command.ts",
            "./extensions/btw.ts",
            "./extensions/exit-command.ts",
            "./extensions/favorite-models/index.ts",
            "./extensions/herdr-agent-state.ts",
            "./extensions/hidden-thinking-label.ts",
            "./extensions/instructions.ts",
            "./extensions/markdown-preview/index.ts",
            "./extensions/mcp-approval.ts",
            "./extensions/memory/src/index.ts",
            "./extensions/path-blacklist/index.ts",
            "./extensions/read-mode-toggle/index.ts",
            "./extensions/subagents/src/index.ts",
            "./extensions/todo.ts",
            "./extensions/working-indicator.ts"
        ],
        "prompts": [
            "./prompts/*.md"
        ],
        "themes": [
            "./themes/*.json"
        ]
    },
    "dependencies": {
        "marked": "^18.1.0"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "^1.1.0",
        "@earendil-works/pi-tui": "^1.1.0",
        "@types/node": "*"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-agent-core": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    }
}
